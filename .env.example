# Browser-safe Supabase project values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Next server-only. The separate worker must never receive this value.
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=http://localhost:3000
HARNEST_URL=http://127.0.0.1:8787
HARNEST_TOKEN=
HARNEST_PUBLIC_NODE_ID=answer
PROVIDER_BRIDGE_TOKEN=replace-with-a-long-random-server-secret
# Pass this URL and PROVIDER_BRIDGE_TOKEN to the Harnest server's HTTP
# HostProvider adapter. The URL is not graph/model input.
HARNEST_PROVIDER_URL=http://127.0.0.1:3000/api/internal/providers/context
HARNEST_PROVIDER_TOKEN=use-the-same-value-as-PROVIDER_BRIDGE_TOKEN

# Explicit opt-in deterministic development mode. Never enable in production.
NEXT_PUBLIC_LOCAL_DEMO=false

# Test apps only. Creates confirmed users without proving email ownership.
AUTH_AUTO_CONFIRM=false
# Test apps only. Reuses the app's reviewed Vault connections for every test account.
ARC_SHARED_TEST_CONNECTIONS=false

# Copy worker/.env.example into the worker deployment. Do not copy the
# Supabase values above into that process.
