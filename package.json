{
  "name": "harnest-nextjs-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "harnest": "node --env-file=.env.local ./node_modules/.bin/harnest serve harnest.example.yaml --port 8787 --allow-modules --allow-files",
    "worker": "node --env-file=worker/.env --import tsx worker/index.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@harnestai/adapter-anthropic": "0.2.0-beta.1",
    "@harnestai/adapter-gemini": "0.2.0-beta.1",
    "@harnestai/adapter-local": "0.2.0-beta.1",
    "@harnestai/adapter-openai": "0.2.0-beta.1",
    "@harnestai/cli": "0.2.0-beta.1",
    "@harnestai/core": "0.2.0-beta.1",
    "@harnestai/protocol": "0.2.0-beta.1",
    "@harnestai/sdk": "0.2.0-beta.1",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.14",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.3.2",
    "supabase": "^2.115.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
